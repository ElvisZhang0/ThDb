{
  "name": "thbd",
  "version": "0.1.0",
  "private": true,
  "description": "ThBD - 数据库管理工具（PostgreSQL / MySQL / KingBase / 达梦）",
  "author": "张萌",
  "main": "dist-electron/main.js",
  "scripts": {
