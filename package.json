    "@types/pg": "^8.11.10",
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
